{
  "name": "kiban",
  "version": "0.0.1",
  "private": true,
  "description": "Kiban is a template for next js apps inspired by the t3 stack.",
  "keywords": [
    "nextjs",
    "template",
    "full-stack"
  ],
  "homepage": "https://kiban.codingcodax.dev",
  "bugs": {
    "url": "https://github.com/codingcodax/kiban/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codingcodax/kiban"
  },
  "license": "MIT",
  "author": {
    "name": "Alexis Guzman",
    "url": "https://github.com/codingcodax"
  },
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "portless kiban next dev",
    "dev:e2e": "next dev",
    "start": "next start",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "fix:unsafe": "ultracite fix --unsafe",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "bun test:unit && bun test:e2e",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "evlog": "^2.19.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "portless": "^0.14.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "superjson": "^2.2.6",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.10.2",
    "postcss": "^8",
    "react-grab": "^0.1.44",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^24.0.0"
  }
}
